# Base URL of the main NeuroSync backend.
VITE_API_BASE_URL=http://localhost:8000
# Keep mock clinical/MRI services enabled until their respective API integrations are configured.
VITE_USE_MOCK_API=true
# Temporary development endpoint for the separately deployed nnU-Net inference service.
# Replace this value when the Colab/ngrok service changes; never hardcode it in source.
VITE_MRI_AI_SERVICE_URL=
VITE_MRI_STATUS_STREAM_URL=
VITE_ENABLE_SPINAL_MRI=false
